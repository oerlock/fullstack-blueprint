RUNTIME_ENV=local

# Redis 缓存（REDIS__ 前缀，默认 127.0.0.1:6382/0，见 docker-compose）
# REDIS__HOST=127.0.0.1
# REDIS__PORT=6382
# REDIS__DATABASE=0
# REDIS__PASSWORD=
# REDIS__KEY_PREFIX=app
# REDIS__REQUIRED=false

# 数据库（DATABASE__ 前缀，默认对准本地 docker-compose MySQL 127.0.0.1:3307）
# DATABASE__HOST=127.0.0.1
# DATABASE__PORT=3307
# DATABASE__USER=app
# DATABASE__PASSWORD=app_password
# DATABASE__DATABASE=app
# DATABASE__TEST_DATABASE=app_test

# 异步任务（TASKS__ 前缀；Broker 默认复用 REDIS__* 的 Redis 实例）
# TASKS__QUEUE_NAME=async_task
# TASKS__CONSUMER_GROUP=async_task_group
# TASKS__MAX_RETRY_COUNT=3
# TASKS__RELAY__POLL_INTERVAL_SECONDS=5
# TASKS__RELAY__BATCH_SIZE=50
# TASKS__RELAY__MAX_ROUNDS_PER_TICK=10
# TASKS__RELAY__RETRY_BASE_DELAY_SECONDS=1
# TASKS__RELAY__RETRY_MAX_DELAY_SECONDS=60
